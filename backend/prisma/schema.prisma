generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Candle {
  broker    String
  symbol    String
  timeframe String
  time      DateTime
  open      Float
  high      Float
  low       Float
  close     Float

  @@id([broker, symbol, timeframe, time])
  @@map("candles")
}

model Trade {
  ticket     Int      @id
  broker     String
  symbol     String
  type       Int
  lots       Float
  openPrice  Float
  closePrice Float
  sl         Float
  tp         Float
  profit     Float
  swap       Float
  commission Float
  magic      Int
  comment    String
  openTime   DateTime
  closeTime  DateTime

  @@index([broker, symbol])
  @@index([broker, closeTime])
  @@index([closeTime])
  @@map("trades")
}

model SettingsMirror {
  id        Int      @id @default(autoincrement())
  broker    String   @unique
  enabled   Boolean  @default(false)
  lotsMode  String   @default("fixed")
  lots      Float    @default(0.01)
  updatedAt DateTime @updatedAt

  @@map("settings_mirror")
}

model SettingsDisplay {
  id             Int      @id @default(autoincrement())
  key            String   @unique @default("global")
  pnlMode        String   @default("net")
  trendlineColor String   @default("#8c8c8c")
  trendlineStyle String   @default("dashed")
  trendlineWidth Int      @default(1)
  hiddenBrokers  String[] @default([])
  hiddenSymbols  Json     @default("{}")
  updatedAt      DateTime @updatedAt

  @@map("settings_display")
}

model PositionColor {
  id      Int    @id @default(autoincrement())
  broker  String
  ticket  Int
  color   String

  @@unique([broker, ticket])
  @@map("position_colors")
}

model User {
  id                Int               @id @default(autoincrement())
  email             String            @unique
  passwordHash      String
  createdAt         DateTime          @default(now())
  chartIndicators   ChartIndicators?
  drawings          Drawing[]
  alerts            PriceAlert[]
  emaCrossAlerts    EmaCrossAlert[]
  emaNotifications  EmaNotification[]
  pushSubscriptions PushSubscription[]

  @@map("users")
}

model PriceAlert {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  broker      String
  symbol      String
  price       Float
  direction   String    // "above" | "below"
  note        String?
  enabled     Boolean   @default(true)
  triggeredAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([broker, symbol, enabled])
  @@map("price_alerts")
}

// Fires when the fast/slow EMAs are converging (about to cross) at candle close,
// within thresholdPips. Evaluated per timeframe, independent of the Engine.
model EmaCrossAlert {
  id            Int       @id @default(autoincrement())
  userId        Int
  user          User      @relation(fields: [userId], references: [id])
  broker        String
  symbol        String
  timeframe     String
  emaFast       Int
  emaSlow       Int
  direction     String    // "buy" | "sell" | "both"
  thresholdPips Float
  note          String?
  enabled       Boolean   @default(true)
  triggeredAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([broker, symbol, enabled])
  @@map("ema_cross_alerts")
}

model PushSubscription {
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User      @relation(fields: [userId], references: [id])
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  lastPushAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

// Standing EMA-cross notification rules (spec 023): evaluated at every candle
// close of their timeframe, repeatable, with an optional end; unlike
// EmaCrossAlert they never disable themselves on firing.
model EmaNotification {
  id            Int                    @id @default(autoincrement())
  userId        Int
  user          User                   @relation(fields: [userId], references: [id])
  broker        String
  symbols       String[]               // empty = every symbol of the broker
  timeframe     String                 // M5 | M15 | H1 | H4 | D1
  emaFast       Int
  emaSlow       Int
  event         String                 // cross | approach | both
  thresholdPips Float                  @default(2)
  direction     String                 // buy | sell | both
  repeatMinutes Int?                   // null = once per event
  endsAt        DateTime?
  enabled       Boolean                @default(true)
  note          String?
  createdAt     DateTime               @default(now())
  events        EmaNotificationEvent[]

  @@index([userId])
  @@index([broker, enabled])
  @@map("ema_notifications")
}

model EmaNotificationEvent {
  id             Int             @id @default(autoincrement())
  notificationId Int
  notification   EmaNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  symbol         String
  kind           String          // cross | approach
  direction      String          // buy | sell
  candleTime     DateTime
  firedAt        DateTime        @default(now())

  @@index([notificationId, symbol, firedAt(sort: Desc)])
  @@map("ema_notification_events")
}

model Drawing {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  broker    String
  symbol    String
  timeframe String
  items     Json     @default("[]")
  updatedAt DateTime @updatedAt

  @@unique([userId, broker, symbol, timeframe])
  @@map("drawings")
}

model ChartIndicators {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])
  emas   Json @default("[]")

  @@map("chart_indicators")
}

model Balance {
  id         Int      @id @default(autoincrement())
  broker     String
  // UTC calendar day of the snapshot; one row per broker and day.
  day        DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  balance    Float
  equity     Float
  profit     Float
  margin     Float
  freeMargin Float
  leverage   Int
  currency   String
  name       String
  number     Int
  timestamp  DateTime @default(now())

  @@unique([broker, day])
  @@index([broker, timestamp])
  @@map("balances")
}

model BalanceOperation {
  ticket  Int      @id
  broker  String
  type    Int
  amount  Float
  comment String
  time    DateTime

  @@index([broker, time])
  @@map("balance_operations")
}

// ---- Libro de esquemas (spec 020): the operator's hand-kept backtest ----

model BookScheme {
  id        Int         @id @default(autoincrement())
  number    Int         @unique
  start     DateTime    @db.Date
  end       DateTime?   @db.Date
  result    String      @default("auto") // "auto" | "T1" | "T2" | "T3" | "RE" | "Pierde" | "Empate"
  note      String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  trades    BookTrade[]

  @@index([start])
  @@map("book_schemes")
}

model BookTrade {
  id           Int        @id @default(autoincrement())
  ticket       Int        @unique
  schemeId     Int
  scheme       BookScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  slot         String     // "T1" | "T2" | "T3" | "RE"
  direction    String     // "buy" | "sell"
  lots         Float
  entry        Float
  sl           Float
  openTime     DateTime
  closeTime    DateTime?  // null while the operation is open
  closePrice   Float?
  profit       Float?     // computed; null while open
  r            Float?
  balanceAfter Float?
  note         String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([schemeId])
  @@map("book_trades")
}
